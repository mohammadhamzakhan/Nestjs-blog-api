generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int        @id @default(autoincrement())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  name               String
  email              String     @unique
  password           String
  role               Role       @default(USER)
  hashedRefreshTokon String?
  profileImageUrl    String?
  blog               Blog[]
  comments           Comments[]

  @@map("users")
}

model Blog {
  id              Int        @id @default(autoincrement())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  title           String     @db.VarChar(255)
  content         String
  slug            String     @unique @db.VarChar(255)
  isDeleted       Boolean    @default(false)
  authorId        Int
  featureImageUrl String?    @db.VarChar(500)
  user            User       @relation(fields: [authorId], references: [id])
  comment         Comments[]

  @@index([authorId])
  @@index([slug])
  @@map("blogs")
}

model Comments {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  email     String?
  comment   String
  blogId    Int
  userId    Int?
  blog      Blog     @relation(fields: [blogId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([blogId])
  @@index([userId])
  @@map("comments")
}

enum Role {
  ADMIN
  USER
}
